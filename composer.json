{
  "name": "universal-carrier/core",
  "description": "A strictly typed, dependency-free specification for shipping carrier integrations in PHP.",
  "keywords": [
    "shipping",
    "carrier",
    "logistics",
    "e-commerce",
    "abstraction",
    "standard",
    "specification",
    "delivery",
    "pickup-points",
    "rates",
    "shipping-label"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Alexandre Debussch\u00e8re",
      "email": "alexandre.debusschere@hey.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "UniversalCarrier\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Demo\\": "demo/",
      "Tests\\": "tests/",
      "UniversalCarrier\\Conformance\\": "conformance/src/"
    }
  },
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "demo": "php demo/run.php",
    "check": [
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
