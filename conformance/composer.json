{
  "name": "universal-carrier/conformance",
  "description": "PHPUnit test cases checking a Universal Carrier driver against the specification.",
  "keywords": [
    "shipping",
    "carrier",
    "conformance",
    "specification",
    "phpunit"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Alexandre Debusschère",
      "email": "alexandre.debusschere@hey.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "UniversalCarrier\\Conformance\\": "src/"
    }
  },
  "require": {
    "php": "^8.4",
    "phpunit/phpunit": "^11.0",
    "universal-carrier/core": "^1.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=512M",
    "check": [
      "@analyse"
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "..",
      "options": {
        "symlink": true,
        "versions": {
          "universal-carrier/core": "1.0.0"
        }
      }
    }
  ]
}
